# History server for HyperRust: receives dictation history from the app and
# keeps it in ~/hyperrust-history/<device>.jsonl, on the Tailscale address only.
# The address is this machine's own: HYPERRUST_HISTORY_BIND in
# ~/.config/hyperrust/build.env (never in the repository).
#
#   install:  scripts/install-history-server.sh
#   status:   systemctl --user status hyperrust-history
[Unit]
Description=HyperRust dictation history server (Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Environment=HYPERRUST_HISTORY_DIR=%h/hyperrust-history
Environment=HYPERRUST_HISTORY_PORT=8791
Environment=HYPERRUST_HISTORY_KEEP=2000
EnvironmentFile=%h/.config/hyperrust/build.env
ExecStart=/usr/bin/python3 %h/.local/lib/hyperrust/history-server.py
# The Tailscale address may appear after boot; retry until it can be bound.
Restart=always
RestartSec=10
NoNewPrivileges=yes
UMask=0077
MemoryMax=128M

[Install]
WantedBy=default.target
